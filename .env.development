# VITE_API_BASE inherited from .env (=/api) so dev calls hit localhost:5173/api.
VITE_CALLING_API_BASE=
VITE_CALLING_WS_URL=
VITE_MIXPANEL_TOKEN=8e68cb40d478c3a509b87a9a0b691d06
# Cloudflare's "always passes" test site key so the widget works on localhost
# without adding it to the real warmchats.com widget. Pairs with the test
# secret in .dev.vars. Production build uses the real key from .env.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
