{
  "name": "WarmChats",
  "short_name": "WarmChats",
  "description": "Turn cold outreach into warm conversations. SMS, email, calls and AI follow-ups in one inbox.",
  "id": "/",
  "start_url": "/inbox",
  "scope": "/",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone",
  "orientation": "any",
  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },
  "categories": ["business", "productivity", "communication"],
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/inbox",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/dashboard",
      "icons": [{ "src": "/web-app-manifest-192x192.png", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "WarmChats inbox on desktop"
    },
    {
      "src": "/screenshots/desktop-wide-2.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "WarmChats dashboard on desktop"
    },
    {
      "src": "/screenshots/mobile-narrow.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "WarmChats inbox on mobile"
    },
    {
      "src": "/screenshots/mobile-narrow-2.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "WarmChats dashboard on mobile"
    }
  ]
}