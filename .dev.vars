# WarmChats - local dev secrets/vars for `wrangler pages dev` (which is what
# `pnpm dev` spawns under the hood via scripts/wrangler.ts).
#
# These values OVERRIDE anything in wrangler.toml [vars] for local runs only.
# `wrangler pages deploy` does NOT upload this file; production reads
# wrangler.toml + secrets set with `wrangler pages secret put`.
#
# Most localhost callback URLs reflect the dev port (5001) - when you wire the
# new Functions integrations
# you'll likely point provider consoles at http://localhost:5173/api/... and
# https://www.warmchats.com/api/... and update these accordingly.

ENV=dev

# When truthy, every outbound SMS/MMS/email goes through functions/_shared/mockSendApi.ts
# and writes to the `mock_send_log` table instead of hitting real providers.
# Unset (or set to 0) to dispatch through the real Telnyx / ElasticEmail / Gmail.
MOCK_SEND_APIS=1

# ---- App identity / URLs ----
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
REPLY_DOMAIN=mail.warmchats.com
SUPPORT_EMAIL=hello@warmchats.com

# ---- Auth ----
JWT_SECRET=dev-only-change-me-1f3c9a7b2e5d4860
EMAIL_UNSUB_SIGNING_KEY=4e6498c39a4317cf4b6a5166e26cbc5c25b817b9b0bb0c9c94ffd1d7ec2d355a
FERNET_KEY=lWPNdUL_iG672PKUtYNOGAceD5VocxeMeAKW3vpAM2c=

# ---- Cloudflare Turnstile ----
# Cloudflare's "always passes" test secret so localhost works without adding it
# to the real widget's hostnames. Pairs with the test site key in
# .env.development. Production uses the real secret from wrangler.toml.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

