# pnpm 11 runs a dependency-status check before every `pnpm <script>` / `pnpm exec`
# and hard-fails (exit 1) when any package's build script is "ignored" (not on the
# approved list). The esbuild/workerd/sharp build scripts are NOT needed here -
# pnpm installs their binaries via platform-specific optional packages - so we skip
# this pre-run check instead. Without this, `pnpm build` / `pnpm upload-*` fail.
verify-deps-before-run=false
